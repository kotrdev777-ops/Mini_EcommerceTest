# Supabase Connect > Transaction pooler (runtime). URL-encode special password characters.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
# Supabase Connect > Direct connection (or Session pooler if IPv4-only).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
# Optional: SESSION_SECRET="your-own-session-secret"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
